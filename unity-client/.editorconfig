root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.shader]
indent_style = space
indent_size = 4

[*.cginc]
indent_style = space
indent_size = 4

[*.compute]
indent_style = space
indent_size = 4

[*.hlsl]
indent_style = space
indent_size = 4

[*.unity]
indent_style = space
indent_size = 2

[*.prefab]
indent_style = space
indent_size = 2

[*.meta]
indent_style = space
indent_size = 2

[*.asset]
indent_style = space
indent_size = 2